# ──────────────────────────────────────────────
#  SciFinder — .gitignore
# ──────────────────────────────────────────────

# 🔒 SECRETOS — ¡NUNCA subir a GitHub! (API keys, conexión a BD)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# 🤖 Configuración local de Claude Code
.claude/

# 📦 Dependencias (se reinstalan con npm install)
node_modules/
**/node_modules/

# 🏗️ Builds / salidas de compilación
dist/
build/
**/dist/
**/build/
.vite/

# 🗃️ Base de datos local (SQLite de desarrollo)
*.sqlite
*.sqlite3
*.db
prisma/*.db
prisma/migrations/dev.db*

# 📝 Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 💻 Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# 🧰 Configuración de editores / IDE
.vscode/
.idea/
*.swp

# 🧪 Cobertura de pruebas
coverage/
