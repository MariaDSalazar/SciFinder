# ──────────────────────────────────────────────
#  SciFinder — Plantilla de variables de entorno (BACKEND)
# ──────────────────────────────────────────────
# CÓMO USAR:
#   1. Copia este archivo y renómbralo a ".env"  (sin .example)
#   2. Rellena los valores reales en ese .env
#   3. El .env NUNCA se sube a GitHub (lo protege el .gitignore)
#   Este .env.example SÍ se sube: sirve de guía, pero sin secretos.

# --- Servidor ---
PORT=3000

# --- Base de datos (PostgreSQL en producción) ---
# Ejemplo: postgresql://usuario:contraseña@localhost:5432/scifinder
DATABASE_URL=

# Para desarrollo local con SQLite, en su lugar usarías:
# DATABASE_URL="file:./dev.db"

# --- API keys de fuentes externas ---
# CORE: regístrate gratis en https://core.ac.uk/services/api
CORE_API_KEY=

# Semantic Scholar (opcional): https://www.semanticscholar.org/product/api
# Funciona sin key, pero con key tienes tu propio cupo de peticiones.
SEMANTIC_SCHOLAR_API_KEY=
