// Esquema de la base de datos de SciFinder.
// PostgreSQL en Neon (https://neon.tech): la misma base sirve para
// desarrollo local y producción; la URL llega por DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un paper guardado como favorito por UNA sesión anónima de navegador.
// La pareja (sessionId, paperId) es única: cada visitante tiene sus propios
// favoritos y dos visitantes pueden guardar el mismo paper sin chocarse.
// "authors" se guarda como JSON en texto; el mapper lo convierte de ida y vuelta.
model FavoritePaper {
  recordId     Int      @id @default(autoincrement())
  sessionId    String
  paperId      String
  title        String
  authors      String
  venue        String?
  year         Int?
  citations    Int      @default(0)
  doi          String?
  pdfUrl       String?
  landingUrl   String?
  isOpenAccess Boolean  @default(false)
  abstract     String?
  topic        String?
  savedAt      DateTime @default(now())

  @@unique([sessionId, paperId])
}

// Registro de cada búsqueda realizada POR SESIÓN (para "búsquedas recientes"
// privadas de cada visitante).
model SearchHistory {
  id        Int      @id @default(autoincrement())
  sessionId String
  query     String
  total     Int
  createdAt DateTime @default(now())
}
